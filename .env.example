# SniffOut's uharness endpoint config — copy to .env in the repo root
# (gitignored) and fill in. Parsed simply: KEY=value per line, # comments,
# values taken literally.

# Full chat-completions endpoint URL (required)
URL=

# Bearer token (optional — omit for keyless servers)
KEY=

# Model for researcher jobs (uharness model="default")
MODEL=

# Cheap model for source cleanup + loop judging (uharness model="fast";
# falls back to MODEL when unset)
FAST_MODEL=
